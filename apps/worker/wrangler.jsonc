{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shelfkit",
  "main": "src/index.ts",
  // 2026-08-04 or later: nodejs_compat is on by default and the flag is ignored.
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
  },
  "limits": {
    "cpu_ms": 30000,
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything that is not a static file goes to the Worker.
    "run_worker_first": [
      "/health",
      "/graphql",
      "/mcp",
      "/apm/*",
      "/raw/*",
      "/auth/*",
    ],
  },
  // The shelf object's migrations are generated SQL files, bundled as text (`drizzle/migrations.js` imports them).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // One Durable Object per shelf, with its own SQLite database, and one per person who signs in to the browser
  // (`AccountIndex`: their passkeys and sign-in links). The migration entries below are generated from the classes
  // `src/index.ts` exports (`moon run worker:do-migrations`), and the gate fails when they disagree.
  "durable_objects": {
    "bindings": [
      { "name": "SHELF", "class_name": "ShelfIndex" },
      { "name": "ACCOUNT", "class_name": "AccountIndex" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ShelfIndex"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountIndex"] },
  ],
  // Content by sha256 under `objects/`; published archives under `archives/`, which a bucket lock keeps immutable;
  // `shelves/` lists the shelves held.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "shelfkit-blobs" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "shelfkit-jobs" }],
    "consumers": [
      {
        "queue": "shelfkit-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "shelfkit-jobs-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "SHELFKIT_VERSION": "0.0.0",
    // Where signing in with GitHub goes: the authorize and token endpoints, and the REST API. Only tests point these
    // at a stand-in GitHub; a deployment keeps github.com.
    "GITHUB_URL": "https://github.com",
    "GITHUB_API_URL": "https://api.github.com",
  },
}
