{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["vite/client"],
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "../worker/schema.graphql",
        "tadaOutputLocation": "./src/api/graphql-env.d.ts"
      }
    ]
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
