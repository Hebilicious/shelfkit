  "owner": "acme",
  "scenarios": [
    {
      "keys": [
        {
          "key": "conformance-publisher-key",
          "name": "publisher",
          "scopes": [
            "publish:acme/*",
            "read"
          ]
        }
      ],
      "name": "round trip",
      "public": true,
      "steps": [
        {
          "expect": {
            "headers": {
              "Content-Type": "application/json"
            },
            "json": {
              "digest": "$digest:web-1.0.0",
              "package": "acme/web",
              "published_at": "$any",
              "size_bytes": "$size:web-1.0.0",
              "version": "1.0.0"
            },
            "status": 201
          },
          "name": "publish 1.0.0",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Cache-Control": "max-age=86400, immutable, public",
              "Content-Length": "$size:web-1.0.0",
              "Content-Type": "application/gzip",
              "Digest": "$rfc3230:web-1.0.0",
              "ETag": "$etag:web-1.0.0"
            },
            "status": 200
          },
          "name": "download returns the published bytes, whose digest is the advertised one",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0/download"
          }
        },
        {
          "expect": {
            "headers": {
              "Cache-Control": "max-age=60, public",
              "Content-Type": "application/json"
            },
            "json": {
              "package": "acme/web",
              "versions": [
                {
                  "digest": "$digest:web-1.0.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0",
                  "version": "1.0.0"
                }
              ]
            },
            "status": 200
          },
          "name": "the listing has the version with the same digest",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions"
          }
        },
        {
          "expect": {
            "headers": {
              "Content-Type": "application/json"
            },
            "json": {
              "digest": "$digest:web-1.1.0",
              "package": "acme/web",
              "published_at": "$any",
              "size_bytes": "$size:web-1.1.0",
              "version": "1.1.0"
            },
            "status": 201
          },
          "name": "publish 1.1.0",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.1.0"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.1.0"
          }
        },
        {
          "expect": {
            "json": {
              "package": "acme/web",
              "versions": [
                {
                  "digest": "$digest:web-1.1.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.1.0",
                  "version": "1.1.0"
                },
                {
                  "digest": "$digest:web-1.0.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0",
                  "version": "1.0.0"
                }
              ]
            },
            "status": 200
          },
          "name": "the listing is newest first",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions"
          }
        },
        {
          "expect": {
            "headers": {
              "ETag": "$etag:web-1.0.0"
            },
            "status": 304
          },
          "name": "a conditional download of an unchanged version is 304",
          "request": {
            "headers": {
              "If-None-Match": "$etag:web-1.0.0"
            },
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0/download"
          }
        },
        {
          "expect": {
            "status": 304
          },
          "name": "a weak validator matches too (RFC 9110 weak comparison)",
          "request": {
            "headers": {
              "If-None-Match": "W/\"sha256:83bb9e0b0f71c3c52d990621a1defaa9dd9ef1db5c234eaa25600e52937cfe1f\""
            },
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0/download"
          }
        },
        {
          "expect": {
            "json": {
              "package": "acme/web",
              "versions": [
                {
                  "digest": "$digest:web-1.1.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.1.0",
                  "version": "1.1.0"
                },
                {
                  "digest": "$digest:web-1.0.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0",
                  "version": "1.0.0"
                }
              ]
            },
            "status": 200
          },
          "name": "a percent-encoded identity names the same package",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme%2Fweb/versions"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 404
          },
          "name": "an unknown version is 404",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/9.9.9/download"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 404
          },
          "name": "an unknown package is 404",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/nothing/versions"
          }
        }
      ]
    },
    {
      "keys": [
        {
          "key": "conformance-publisher-key",
          "name": "publisher",
          "scopes": [
            "publish:acme/*",
            "read"
          ]
        }
      ],
      "name": "immutability",
      "public": true,
      "steps": [
        {
          "expect": {
            "headers": {
              "Content-Type": "application/json"
            },
            "json": {
              "digest": "$digest:web-1.0.0",
              "package": "acme/web",
              "published_at": "$any",
              "size_bytes": "$size:web-1.0.0",
              "version": "1.0.0"
            },
            "status": 201
          },
          "name": "publish 1.0.0",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "json": {
              "extensions": {
                "previous_digest": "$digest:web-1.0.0",
                "previous_publish": "$any"
              }
            },
            "problem": true,
            "status": 409
          },
          "name": "the same body again is 409",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 409
          },
          "name": "a different body is 409",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-other"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 409
          },
          "name": "the same version under different letter case is 409",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-other"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/ACME/Web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "json": {
              "package": "Acme/WEB",
              "versions": [
                {
                  "digest": "$digest:web-1.0.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0",
                  "version": "1.0.0"
                }
              ]
            },
            "status": 200
          },
          "name": "a listing under different letter case is the same package",
          "request": {
            "method": "GET",
            "path": "/v1/packages/Acme/WEB/versions"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 409
          },
          "name": "a different body of another type is still 409",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-zip"
            },
            "headers": {
              "Content-Type": "application/zip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "json": {
              "package": "acme/web",
              "versions": [
                {
                  "digest": "$digest:web-1.0.0",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0",
                  "version": "1.0.0"
                }
              ]
            },
            "status": 200
          },
          "name": "the listing still has only the first publish",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions"
          }
        },
        {
          "expect": {
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Cache-Control": "max-age=86400, immutable, public",
              "Content-Length": "$size:web-1.0.0",
              "Content-Type": "application/gzip",
              "Digest": "$rfc3230:web-1.0.0",
              "ETag": "$etag:web-1.0.0"
            },
            "status": 200
          },
          "name": "the download is still the first body",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0/download"
          }
        }
      ]
    },
    {
      "keys": [
        {
          "key": "conformance-publisher-key",
          "name": "publisher",
          "scopes": [
            "publish:acme/*",
            "read"
          ]
        }
      ],
      "name": "a version with build metadata",
      "public": true,
      "steps": [
        {
          "expect": {
            "headers": {
              "Content-Type": "application/json"
            },
            "json": {
              "digest": "$digest:web-1.0.0+build.1",
              "package": "acme/web",
              "published_at": "$any",
              "size_bytes": "$size:web-1.0.0+build.1",
              "version": "1.0.0+build.1"
            },
            "status": 201
          },
          "name": "publish 1.0.0+build.1 with the + percent-encoded",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0+build.1"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0%2Bbuild.1"
          }
        },
        {
          "expect": {
            "json": {
              "package": "acme/web",
              "versions": [
                {
                  "digest": "$digest:web-1.0.0+build.1",
                  "published_at": "$any",
                  "size_bytes": "$size:web-1.0.0+build.1",
                  "version": "1.0.0+build.1"
                }
              ]
            },
            "status": 200
          },
          "name": "the listing has the version as published",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions"
          }
        },
        {
          "expect": {
            "body": {
              "archive": "web-1.0.0+build.1"
            },
            "headers": {
              "Content-Type": "application/gzip",
              "ETag": "$etag:web-1.0.0+build.1"
            },
            "status": 200
          },
          "name": "download with the + percent-encoded, as APM sends it",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0%2Bbuild.1/download"
          }
        },
        {
          "expect": {
            "body": {
              "archive": "web-1.0.0+build.1"
            },
            "headers": {
              "Content-Type": "application/gzip",
              "ETag": "$etag:web-1.0.0+build.1"
            },
            "status": 200
          },
          "name": "download with a literal + names the same version",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions/1.0.0+build.1/download"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 409
          },
          "name": "the same version again is 409",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0+build.1"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0%2Bbuild.1"
          }
        }
      ]
    },
    {
      "keys": [
        {
          "key": "conformance-publisher-key",
          "name": "publisher",
          "scopes": [
            "publish:acme/*",
            "read"
          ]
        }
      ],
      "name": "archive format",
      "public": true,
      "steps": [
        {
          "expect": {
            "problem": true,
            "status": 415
          },
          "name": "zip is refused with 415",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-zip"
            },
            "headers": {
              "Content-Type": "application/zip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 415
          },
          "name": "a tar.gz with another Content-Type is 415",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Content-Type": "application/octet-stream"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 415
          },
          "name": "no Content-Type is 415",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 400
          },
          "name": "a truncated gzip stream is 400",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-truncated-gzip"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "problem": true,
            "status": 404
          },
          "name": "nothing was stored",
          "request": {
            "method": "GET",
            "path": "/v1/packages/acme/web/versions"
          }
        },
        {
          "expect": {
            "headers": {
              "Content-Type": "application/json"
            },
            "json": {
              "digest": "$digest:web-1.0.0",
              "package": "acme/web",
              "published_at": "$any",
              "size_bytes": "$size:web-1.0.0",
              "version": "1.0.0"
            },
            "status": 201
          },
          "name": "Content-Type parameters are allowed",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0"
            },
            "headers": {
              "Content-Type": "application/gzip; charset=binary"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        }
      ]
    },
    {
      "keys": [
        {
          "key": "conformance-publisher-key",
          "name": "publisher",
          "scopes": [
            "publish:acme/*",
            "read"
          ]
        }
      ],
      "name": "publish validation",
      "public": true,
      "steps": [
        {
          "expect": {
            "json": {
              "extensions": {
                "errors": [
                  "the archive has no apm.yml at its root"
                ]
              }
            },
            "problem": true,
            "status": 422
          },
          "name": "an archive without apm.yml is 422",
          "request": {
            "auth": {
              "bearer": "publisher"
            },
            "body": {
              "archive": "web-1.0.0-no-manifest"
            },
            "headers": {
              "Content-Type": "application/gzip"
            },
            "method": "PUT",
            "path": "/v1/packages/acme/web/versions/1.0.0"
          }
        },
        {
          "expect": {
            "json": {
              "extensions": {
                "errors": [
                  "apm.yml declares version `9.9.9`, but the archive is published as `2.0.0`; the two must match"
                ]
              }
            },
            "problem": true,
